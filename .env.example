# Notion Integration secret (https://www.notion.so/my-integrations)
NOTION_TOKEN=ntn_your_token_here

# Notion page id where Blackswan pastes source materials
NOTION_SOURCE_PAGE_ID=your_source_page_id_here

# Notion database id where the timeline will be written
NOTION_TIMELINE_DB_ID=your_timeline_db_id_here

# Anthropic API key (https://console.anthropic.com)
LLM_API_KEY=sk-ant-your_key_here

# LLM model
LLM_MODEL=claude-sonnet-4-6
